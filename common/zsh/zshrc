# TEMA POWERLEVEL10K
# ==========================================
source ~/powerlevel10k/powerlevel10k.zsh-theme

# ==========================================
# PLUGINS
# ==========================================
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# ==========================================
# CONFIG POWERLEVEL10K
# ==========================================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ==========================================
# PATH
# ==========================================
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# ==========================================
# ALIAS
# ==========================================
alias cat='bat'
alias catn='bat --style=plain'
alias catnp='bat --style=plain --paging=never'
alias ll='lsd -lh --group-dirs=first'
alias la='lsd -a --group-dirs=first'
alias l='lsd --group-dirs=first'
alias lla='lsd -la --group-dirs=first'
alias ls='lsd --group-dirs=first'

# ==========================================
# FIX LSD
# ==========================================
export LS_COLORS="$(echo $LS_COLORS | sed 's/:01;/:/g')"

# ==========================================
# FUNCIONES HTB
# ==========================================
# Target HTB para polybar
target() {
    local target_file="$HOME/.config/polybar/hack/.target"
    if [ -z "$1" ]; then
        echo "" > "$target_file"
        echo "[+] Target limpiado"
    elif [ -z "$2" ]; then
        echo "$1" > "$target_file"
        echo "[+] Target: $1"
    else
        echo "$1 $2" > "$target_file"
        echo "[+] Target: $1 - $2"
    fi
}

# ==========================================
# COLORES ZSH SYNTAX HIGHLIGHTING
# ==========================================
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=blue,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=cyan'
ZSH_HIGHLIGHT_STYLES[function]='fg=cyan'
ZSH_HIGHLIGHT_STYLES[path]='fg=cyan'
ZSH_HIGHLIGHT_STYLES[alias]='fg=blue'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=magenta,bold'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=yellow'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=white'
ZSH_HIGHLIGHT_STYLES[argument]='fg=white'
ZSH_HIGHLIGHT_STYLES[option]='fg=yellow'
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#5c7c99'

# ==========================================
