#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d term web tools files vuln scan notes misc sys

bspc config border_width         2
bspc config window_gap           8
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc config top_padding          28
bspc config bottom_padding       40
bspc config left_padding         8
bspc config right_padding        8

bspc config normal_border_color   "#30363d"
bspc config active_border_color   "#3da9fc"
bspc config focused_border_color  "#74c0fc"
bspc config presel_feedback_color "#4cc9f0"

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bspc rule -a firefox desktop='^2' follow=on
bspc rule -a thunar state=floating

# --- Fondo de pantalla (ruta neutral, sin depender del idioma del sistema) ---
feh --bg-fill ~/.config/wallpapers/Spectre_x46.png &

# --- Ajustes ESPECÍFICOS DE LA MÁQUINA (los pone install.sh según el perfil) ---
# vmware -> vmware-user-suid-wrapper, randr-watcher, xrandr --auto
# victus -> NVIDIA (ForceFullCompositionPipeline) + xrandr con refresh 144Hz
[ -f ~/.config/bspwm/machine.sh ] && . ~/.config/bspwm/machine.sh

# --- Barra y compositor (comunes) ---
~/.config/polybar/launch.sh --hack &
picom --config ~/.config/picom/picom.conf &
